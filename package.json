{
	"name": "pawcelona-pet-care",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"prepare:static": "node scripts/generate-static-files.mjs",
		"build": "ng build",
		"build:prod": "npm run prepare:static && ng build --configuration production",
		"build:release": "npm run check:source && npm run check:launch && npm run build:prod",
		"check:launch": "node scripts/preflight.mjs",
		"check:source": "node scripts/source-check.mjs",
		"watch": "ng build --watch --configuration development"
	},
	"dependencies": {
		"@angular/common": "22.1.7",
		"@angular/compiler": "22.1.7",
		"@angular/core": "22.1.7",
		"@angular/forms": "22.1.7",
		"@angular/platform-browser": "22.1.7",
		"@angular/platform-server": "22.1.7",
		"@angular/router": "22.1.7",
		"@angular/ssr": "22.1.7",
		"rxjs": "~7.8.2",
		"tslib": "^2.8.1",
		"zone.js": "~0.15.0"
	},
	"devDependencies": {
		"@angular/build": "^22.1.4",
		"@angular/cli": "^22.1.4",
		"@angular/compiler-cli": "^22.1.4",
		"@tailwindcss/postcss": "^4.1.12",
		"postcss": "^8.5.6",
		"tailwindcss": "^4.1.12",
		"typescript": "~6.0.0"
	}
}
